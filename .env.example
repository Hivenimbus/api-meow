# ============================================================
# API Meow — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores.
# ============================================================

# ----------------------------------------------------------
# Back-end (Go / Fiber)
# ----------------------------------------------------------

# URL de conexão com o banco de dados PostgreSQL
# Formato: postgres://usuario:senha@host:porta/banco?sslmode=disable
DATABASE_URL=postgres://postgres:senha@localhost:5432/api_meow?sslmode=disable

# Chave de autenticação da API (usada no header Authorization)
# Pode ser qualquer string segura e aleatória
APIKEY=

# ----------------------------------------------------------
# Front-end (Nuxt 3)
# ----------------------------------------------------------

# URL base do back-end Go.
# Em desenvolvimento local, normalmente http://localhost:8080
BACKEND_URL=http://localhost:8080
